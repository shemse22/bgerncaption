      "segments": [
        {
          "id": "seg-1",
          "start": 0.5,
          "end": 3.8,
          "text": "እንደምን አደራችሁ ክቡራትና ክቡራን።"
        },
        {
          "id": "seg-2",
          "start": 4.2,
          "end": 7.9,
          "text": "ዛሬ ወደ አዲስ የቪዲዮ ይዘት እንኳን ደህና መጣችሁ።"
