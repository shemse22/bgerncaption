        {
          "id": "seg-3",
          "start": 8.4,
          "end": 12.1,
          "text": "የዛሬው ርዕሳችን ስለ ዲጂታል ፈጠራ እና ቴክኖሎጂ ነው።"
        },
        {
          "id": "seg-4",
          "start": 12.6,
          "end": 16.5,
          "text": "ይህንን ቪዲዮ እስከ መጨረሻው እንዲከታተሉ እንጋብዛለን።"
        },
        {
          "id": "seg-5",
          "start": 17,
          "end": 21.2,
          "text": "አስተያየት ካላችሁ በኮሜንት መስጫው ላይ ጻፉልን።"
        }
